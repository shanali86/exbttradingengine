# exbeast-mm-bot settings. Copy to .env (never commit .env: it holds the API secret).

# Market maker account API key (admin panel -> Exchange listings -> MM accounts -> API keys, "Trade").
EXBEAST_API_URL=https://api.spot.thinkoworkspace.com
EXBEAST_API_KEY=
EXBEAST_API_SECRET=

MM_SYMBOL=EXBT-USDT
# fixed = around MM_MID_PRICE | last = around the last trade (MM_MID_PRICE, then the
# market's reference price, before one) | book = middle of the best bid and ask.
MM_MID_SOURCE=last
MM_MID_PRICE=0.39

# Ladder: MM_LEVELS buy and sell orders of MM_ORDER_SIZE base each. Best bid to best ask is
# MM_SPREAD_BPS (100 = 1%); every further level is MM_STEP_BPS more away.
MM_LEVELS=5
MM_ORDER_SIZE=5
MM_SPREAD_BPS=100
MM_STEP_BPS=50
# Move the ladder only once the mid moved this far (keeps queue priority).
MM_REQUOTE_BPS=25
MM_REFRESH_MS=5000

# Never quote with the last bit of the balance (0 = use it all).
MM_MIN_BASE_BALANCE=0
MM_MIN_QUOTE_BALANCE=0

# Cancel every order of the bot on this market when it stops (Ctrl+C / SIGTERM).
MM_CANCEL_ON_EXIT=true
# true = only print what it would do.
MM_DRY_RUN=false
